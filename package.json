{
  "name": "sharity",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.13.0",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.26",
      "lucide-react": "^1.28.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:landing": "turbo run dev -F landing",
    "dev:server": "turbo run dev -F server",
    "kill-dev": "lsof -ti:3000,3001,3002,8080 | xargs kill -9 2>/dev/null || true",
    "db:push": "turbo run db:push -F @sharity/db",
    "db:studio": "turbo run db:studio -F @sharity/db",
    "db:generate": "turbo run db:generate -F @sharity/db",
    "db:migrate": "turbo run db:migrate -F @sharity/db",
    "db:local": "turbo run db:local -F @sharity/db"
  },
  "dependencies": {
    "@sharity/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sharity/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
